{
  "description": "Reusable call-to-action section",
  "id": "cta",
  "name": "Cta",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Call-to-action section with background image and button",
      "docURL": "https://prismic.io/docs/slices",
      "id": "default",
      "imageUrl": "",
      "items": {},
      "name": "Default",
      "primary": {
        "cta_img": {
          "config": {
            "constraint": {},
            "label": "Background Image",
            "thumbnails": []
          },
          "type": "Image"
        },
        "cta_heading": {
          "config": {
            "allowTargetBlank": false,
            "label": "Heading",
            "multi": "heading1,heading2,heading3,heading4,heading5,heading6,strong,em",
            "placeholder": "Ready to get started?"
          },
          "type": "StructuredText"
        },
        "cta_description": {
          "config": {
            "label": "Description",
            "placeholder": "Add a short supporting message"
          },
          "type": "Text"
        },
        "button_label": {
          "config": {
            "label": "Button Label",
            "placeholder": "Get started"
          },
          "type": "Text"
        },
        "button_link": {
          "config": {
            "allowTargetBlank": true,
            "label": "Button Link",
            "placeholder": "Select a page or enter a URL",
            "select": null
          },
          "type": "Link"
        }
      },
      "version": "initial"
    }
  ]
}