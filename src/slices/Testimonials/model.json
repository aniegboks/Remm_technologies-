{
  "id": "testimonials",
  "type": "SharedSlice",
  "name": "Testimonials",
  "description": "Reusable testimonial carousel",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "A carousel with text and image testimonial cards",
      "version": "initial",
      "primary": {
        "section_heading": {
          "type": "StructuredText",
          "config": {
            "label": "Section Heading",
            "placeholder": "What our clients say",
            "allowTargetBlank": false,
            "multi": "heading1,heading2"
          }
        },
        "section_description": {
          "type": "Text",
          "config": {
            "label": "Section Description",
            "placeholder": "Optional introduction to the testimonials"
          }
        },
        "testimonials": {
          "type": "Group",
          "config": {
            "label": "Testimonials",
            "repeat": true,
            "fields": {
              "card_type": {
                "type": "Select",
                "config": {
                  "label": "Card Layout",
                  "placeholder": "Choose a layout",
                  "options": [
                    "text",
                    "image"
                  ],
                  "default_value": "text"
                }
              },
              "name": {
                "type": "Text",
                "config": {
                  "label": "Person or Organization",
                  "placeholder": "Name"
                }
              },
              "role": {
                "type": "Text",
                "config": {
                  "label": "Role or Additional Detail",
                  "placeholder": "Job title, company, or context"
                }
              },
              "avatar": {
                "type": "Image",
                "config": {
                  "label": "Profile Image",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "quote": {
                "type": "StructuredText",
                "config": {
                  "label": "Testimonial",
                  "placeholder": "Enter the testimonial",
                  "allowTargetBlank": false,
                  "multi": "paragraph"
                }
              },
              "image": {
                "type": "Image",
                "config": {
                  "label": "Full Card Image",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "background_style": {
                "type": "Select",
                "config": {
                  "label": "Text Card Background",
                  "placeholder": "Choose a background",
                  "options": [
                    "slate",
                    "purple",
                    "blue",
                    "white"
                  ],
                  "default_value": "slate"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}