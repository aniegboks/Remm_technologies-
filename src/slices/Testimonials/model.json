{
  "description": "Reusable testimonial carousel",
  "id": "testimonials",
  "name": "Testimonials",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "A carousel with text and image testimonial cards",
      "docURL": "https://prismic.io/docs/slices",
      "id": "default",
      "imageUrl": "",
      "items": {},
      "name": "Default",
      "primary": {
        "section_heading": {
          "config": {
            "allowTargetBlank": false,
            "label": "Section Heading",
            "multi": "heading1,heading2",
            "placeholder": "What our clients say"
          },
          "type": "StructuredText"
        },
        "section_description": {
          "config": {
            "label": "Section Description",
            "placeholder": "Optional introduction to the testimonials"
          },
          "type": "Text"
        },
        "testimonials": {
          "config": {
            "fields": {
              "card_type": {
                "config": {
                  "label": "Card Layout",
                  "options": [
                    "text",
                    "image"
                  ],
                  "placeholder": "Choose a layout"
                },
                "type": "Select"
              },
              "name": {
                "config": {
                  "label": "Person or Organization",
                  "placeholder": "Name"
                },
                "type": "Text"
              },
              "role": {
                "config": {
                  "label": "Role or Additional Detail",
                  "placeholder": "Job title, company, or context"
                },
                "type": "Text"
              },
              "avatar": {
                "config": {
                  "constraint": {},
                  "label": "Profile Image",
                  "thumbnails": []
                },
                "type": "Image"
              },
              "quote": {
                "config": {
                  "allowTargetBlank": false,
                  "label": "Testimonial",
                  "multi": "paragraph",
                  "placeholder": "Enter the testimonial"
                },
                "type": "StructuredText"
              },
              "image": {
                "config": {
                  "constraint": {},
                  "label": "Full Card Image",
                  "thumbnails": []
                },
                "type": "Image"
              },
              "background_style": {
                "config": {
                  "label": "Text Card Background",
                  "options": [
                    "slate",
                    "purple",
                    "blue",
                    "white"
                  ],
                  "placeholder": "Choose a background"
                },
                "type": "Select"
              }
            },
            "label": "Testimonials",
            "repeat": true
          },
          "type": "Group"
        }
      },
      "version": "initial"
    }
  ]
}