{
  "id": "recent",
  "type": "SharedSlice",
  "name": "Recent",
  "description": "Recent projects or properties section",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "",
      "version": "initial",
      "description": "Recent content with configurable heading, navigation, and cards",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Section Heading",
            "placeholder": "Enter the section heading",
            "allowTargetBlank": true,
            "single": "heading1"
          }
        },
        "paragraph": {
          "type": "StructuredText",
          "config": {
            "label": "Section Description",
            "placeholder": "Describe this section",
            "multi": "paragraph"
          }
        },
        "navigator": {
          "type": "Group",
          "config": {
            "label": "Navigation Buttons",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Button Label",
                  "placeholder": "View all projects"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Button Destination",
                  "placeholder": "Choose a page or URL",
                  "allowTargetBlank": true,
                  "select": null
                }
              }
            }
          }
        }
      },
      "items": {
        "display_img": {
          "type": "Image",
          "config": {
            "label": "Card Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "display_text": {
          "type": "Text",
          "config": {
            "label": "Card Title",
            "placeholder": "Enter a card title"
          }
        },
        "display_geo": {
          "type": "Text",
          "config": {
            "label": "Location",
            "placeholder": "Enter a location"
          }
        },
        "display_link": {
          "type": "Link",
          "config": {
            "label": "Card Destination",
            "placeholder": "Choose a page or URL",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "display_action_label": {
          "type": "Text",
          "config": {
            "label": "Card Action Label",
            "placeholder": "Learn more"
          }
        }
      }
    }
  ]
}