{
  "description": "Recent projects or properties section",
  "id": "recent",
  "name": "Recent",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Recent content with configurable heading, navigation, and cards",
      "docURL": "",
      "id": "default",
      "imageUrl": "https://images.prismic.io/slice-machine/621a5ec4-0387-4bc5-9860-2dd46cbc07cd_default_ss.png?auto=compress,format",
      "items": {
        "display_img": {
          "config": {
            "constraint": {},
            "label": "Card Image",
            "thumbnails": []
          },
          "type": "Image"
        },
        "display_text": {
          "config": {
            "label": "Card Title",
            "placeholder": "Enter a card title"
          },
          "type": "Text"
        },
        "display_geo": {
          "config": {
            "label": "Location",
            "placeholder": "Enter a location"
          },
          "type": "Text"
        },
        "display_link": {
          "config": {
            "allowTargetBlank": true,
            "label": "Card Destination",
            "placeholder": "Choose a page or URL",
            "select": null
          },
          "type": "Link"
        },
        "display_action_label": {
          "config": {
            "label": "Card Action Label",
            "placeholder": "Learn more"
          },
          "type": "Text"
        }
      },
      "name": "Default",
      "primary": {
        "heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Section Heading",
            "placeholder": "Enter the section heading",
            "single": "heading1"
          },
          "type": "StructuredText"
        },
        "paragraph": {
          "config": {
            "label": "Section Description",
            "multi": "paragraph",
            "placeholder": "Describe this section"
          },
          "type": "StructuredText"
        },
        "navigator": {
          "config": {
            "fields": {
              "label": {
                "config": {
                  "label": "Button Label",
                  "placeholder": "View all projects"
                },
                "type": "Text"
              },
              "link": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Button Destination",
                  "placeholder": "Choose a page or URL",
                  "select": null
                },
                "type": "Link"
              }
            },
            "label": "Navigation Buttons",
            "repeat": true
          },
          "type": "Group"
        }
      },
      "version": "initial"
    }
  ]
}